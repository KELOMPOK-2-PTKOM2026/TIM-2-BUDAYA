{
  "name": "tim-2-budaya-monorepo",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "install:all": "npm install && npm --prefix frontend install && cd backend && composer install",
    "dev:frontend": "npm --prefix frontend start",
    "dev:backend": "cd backend && php artisan serve",
    "dev": "concurrently -c \"cyan,magenta\" -n \"REACT,LARAVEL\" \"npm run dev:frontend\" \"npm run dev:backend\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
