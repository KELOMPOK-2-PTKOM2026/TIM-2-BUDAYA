root = true

# Pengaturan umum
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Konfigurasi Frontend (React/JavaScript/TypeScript)
[*.{js,jsx,ts,tsx,json,css,scss,html,md}]
indent_style = space
indent_size = 2

# Konfigurasi Backend (Laravel/PHP)
[*.php]
indent_style = space
indent_size = 4
